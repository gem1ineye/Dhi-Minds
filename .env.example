# Dhi Minds — environment configuration
# Copy to .env.local and fill in real values. Every key is documented; no
# values are committed (NFR-ENG-06). See Appendix B of the PRD for the full
# list of business-owned configuration this maps to.

# --- Site -------------------------------------------------------------
# Canonical domain, used for canonical URLs, sitemap, OG/Twitter tags.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# --- Company / contact (Appendix B) ------------------------------------
NEXT_PUBLIC_CONTACT_EMAIL=hello@example.com
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_PRIMARY_LOCATION=
NEXT_PUBLIC_RESPONSE_SLA=one business day
NEXT_PUBLIC_RETENTION_PERIOD=24 months
NEXT_PUBLIC_GRIEVANCE_CONTACT=

# Social profiles — leave any platform blank to omit it from the footer (FR-FOOT-04).
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_LINKEDIN=
NEXT_PUBLIC_SOCIAL_X=
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_YOUTUBE=
NEXT_PUBLIC_SOCIAL_BEHANCE=

# --- Pricing (CR-06 — leave blank for "On request") ---------------------
NEXT_PUBLIC_CURRENCY=INR
PRICE_STARTER=
PRICE_GROWTH=
PRICE_SCALE=
# Consultation booking fee, in the minor unit of NEXT_PUBLIC_CURRENCY (paise
# for INR). Leave blank to hide the consultation booking flow entirely.
PRICE_CONSULTATION=

# --- WhatsApp (direct contact channel) -----------------------------------
# E.164 digits only, no "+" (wa.me format), e.g. 919876543210. Leave blank
# to omit WhatsApp from "Talk to us" and hide the floating chat bubble.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# --- Razorpay (one-time payments — Orders API, not Subscriptions) --------
# Public key id — safe to expose client-side, used by Checkout.js.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
# Secret key — server-only. Used for order creation and payment signature
# verification. NEVER prefix this with NEXT_PUBLIC_.
RAZORPAY_KEY_SECRET=
# Separate secret from the Razorpay Dashboard's webhook settings (Settings ->
# Webhooks) — not the same value as RAZORPAY_KEY_SECRET.
RAZORPAY_WEBHOOK_SECRET=

# --- Content governance --------------------------------------------------
# Set to "true" only in non-production preview environments to allow
# isPlaceholder:true content to render (FR-CMS-03, CR-05). Never set this in
# a production deploy.
ALLOW_PLACEHOLDER_CONTENT=false

# --- Database (PRD §10.1 — MongoDB Atlas) --------------------------------
MONGODB_URI=
MONGODB_DB=meridian

# --- Email (Resend) -------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="Dhi Minds <inquiries@example.com>"
TEAM_NOTIFICATION_EMAIL=

# --- Security --------------------------------------------------------------
# Salt used to hash visitor IPs before storage (FR-API-03). Set a real
# random value in production; never reuse the dev default.
IP_HASH_SALT=change-me-in-production

# --- Analytics (optional, FR-ANL-05/07) -------------------------------------
# Provider script is not wired by default; lib/analytics.ts is a no-op-safe
# wrapper you can point at Plausible/Umami/GA4 in one place.
